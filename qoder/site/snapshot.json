        {
          "id": "02-文献阅读与笔记方法.md::0::7c73637b",
          "title": "文献阅读与笔记方法",
          "source": "02-文献阅读与笔记方法.md",
          "chunkIndex": 0,
          "snippet": "读论文先看摘要和结论，再看图，再回头读方法。很多时间花在读引言上，但真正决定能不能复现的是方法与实验设置。 做笔记不要抄原文，要写「这句话回答了什么问题」。抄原文的笔记在检索时很难命中，因为查询词和作者用词不一致。 一个可复用的笔记模板：问题 / 方法 / 数据 / 结论 / 我的疑问 / 与哪篇论文冲突。最后一项最容易忽略，但它是综述写作的抓手。 复习要主动。看完当天写三句话概括，隔三天再写一次，一周后再写一次。这个间隔重复的节奏对长期记忆的留存率提升很明显。",
          "hitBy": "vector",
          "rrfScore": 0.0156,
          "vecRank": 4,
          "ftRank": null
        },
        {
          "id": "03-hybrid-retrieval-notes.md::1::b81c49ef",
          "title": "Reading Notes on Hybrid Retrieval",
          "source": "03-hybrid-retrieval-notes.md",
          "chunkIndex": 1,
          "snippet": "Full text search with an inverted index is unbeatable for rare identifiers such as error codes or author names. Dense vectors are weak on those but strong on paraphrases. That asymmetry is exactly why hybrid retrieval beats either branch alone.",
          "hitBy": "vector",
          "rrfScore": 0.0156,
          "vecRank": 4,
          "ftRank": null
        }
      ]
